<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>OBK.AndroidApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationTitle>OBK</ApplicationTitle>
    <ApplicationId>cz.obk.reader</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>29.0</SupportedOSPlatformVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <PublishTrimmed>false</PublishTrimmed>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <LocalizedStrings Include="Localization\AppStrings.resx" />
  </ItemGroup>
  <Import Project="..\Localization.targets" />
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\obk.png" />
    <MauiImage Include="Resources\Images\*.svg" BaseSize="24,24" />
    <MauiSplashScreen Include="Resources\AppIcon\obk.png" Color="#0F6CBD" BaseSize="128,128" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.4" />
    <ProjectReference Include="..\OBK.Core\OBK.Core.csproj" />
    <EmbeddedResource Include="..\..\data\schools.json.gz" LogicalName="OBK.schools.json.gz" />
  </ItemGroup>
</Project>
