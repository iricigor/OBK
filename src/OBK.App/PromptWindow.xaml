<Window x:Class="OBK.App.PromptWindow" Icon="pack://application:,,,/Assets/OBK.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Style="{StaticResource {x:Type Window}}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="WindowClosing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="40">
                <TextBlock Text="OBK" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="24,0"/>
                <Button x:Name="CloseButton" HorizontalAlignment="Right" Width="40" Height="40" Style="{StaticResource SubtleButton}"
                        Click="CancelClick" ToolTip="Close" AutomationProperties.Name="Close"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10"/>
                </Button>
            </Grid>
            <StackPanel Margin="24,4,24,20">
                <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock x:Name="Description" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14"/>
                <TextBlock x:Name="FieldLabel" FontSize="12.5" Margin="0,0,0,6"/>
                <TextBox x:Name="ValueText" Visibility="Collapsed"/>
                <PasswordBox x:Name="PasswordInput" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="SubmitButton" Style="{StaticResource PrimaryButton}" MinWidth="96" IsDefault="True" Click="SubmitClick"/>
                    <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" Margin="8,0,0,0" IsCancel="True" Click="CancelClick"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
