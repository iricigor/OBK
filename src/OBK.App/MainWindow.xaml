<Window x:Class="OBK.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:OBK.App.Localization"
        xmlns:local="clr-namespace:OBK.App"
        Style="{StaticResource {x:Type Window}}" Title="{Binding WindowTitle}" Icon="pack://application:,,,/OBK;component/Assets/OBK.ico"
        Width="1380" Height="840" MinWidth="880" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize"
        Loaded="WindowLoaded" Closing="WindowClosing" SizeChanged="WindowSizeChanged" SourceInitialized="WindowSourceInitialized">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="WindowRoot" Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource HeaderSurface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1"/>
        <Grid>
            <StackPanel Orientation="Horizontal" Margin="20,0,240,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/OBK;component/Assets/OBK.ico" Width="16" Height="16" Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="OBK"/>
                <TextBlock Text="{x:Static loc:AppStrings.AppTitle}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Width="46" Height="40" MinHeight="0" Style="{StaticResource SubtleButton}" Command="{Binding ToggleThemeCommand}"
                        ToolTip="{Binding Theme.ToggleTooltip}" AutomationProperties.Name="{Binding Theme.ToggleTooltip}">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Theme.ToggleIcon}" FontSize="12"/>
                </Button>
                <Button Width="46" Height="40" MinHeight="0" Style="{StaticResource SubtleButton}"
                        Command="{Binding MinimizeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="{x:Static loc:AppStrings.WindowMinimize}" AutomationProperties.Name="{x:Static loc:AppStrings.WindowMinimize}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE921;" FontSize="10"/>
                </Button>
                <Button x:Name="MaximizeButton" Width="46" Height="40" MinHeight="0" Style="{StaticResource SubtleButton}"
                        Command="{Binding MaximizeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="{x:Static loc:AppStrings.WindowMaximizeTooltip}" AutomationProperties.Name="{x:Static loc:AppStrings.WindowMaximizeName}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE922;" FontSize="10"/>
                </Button>
                <Button Width="46" Height="40" MinHeight="0" Style="{StaticResource CloseButton}" Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="{x:Static loc:AppStrings.CommonClose}" AutomationProperties.Name="{x:Static loc:AppStrings.CommonClose}">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8BB;" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="210" MinWidth="64" MaxWidth="400"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition x:Name="MessageColumn" Width="360" MinWidth="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            <GridSplitter x:Name="NavigationSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" ShowsPreview="False" DragCompleted="NavigationSplitterDragCompleted"
                          ToolTip="{x:Static loc:AppStrings.SidebarResizeTooltip}" AutomationProperties.Name="{x:Static loc:AppStrings.SidebarResizeName}"/>
            <DockPanel Margin="4,8,4,0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <ItemsControl x:Name="AccountList" ItemsSource="{Binding Accounts}" AutomationProperties.Name="{x:Static loc:AppStrings.SidebarChildrenName}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SubtleButton}" Command="{Binding DataContext.SelectAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding Label}"
                                        HorizontalContentAlignment="Stretch" Height="40" Padding="8,0" Margin="0,0,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border CornerRadius="2" Background="{DynamicResource Accent}" Height="20"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource VisibleIf}}"/>
                                        <Border Grid.Column="1" Width="28" Height="28" CornerRadius="14" Margin="6,0,0,0">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource ThemeBrush}" ConverterParameter="Bg">
                                                    <Binding Path="ColorKey"/>
                                                    <Binding Path="DataContext.Theme.IsDark" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Foreground>
                                                    <MultiBinding Converter="{StaticResource ThemeBrush}" ConverterParameter="Fg">
                                                        <Binding Path="ColorKey"/>
                                                        <Binding Path="DataContext.Theme.IsDark" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Label}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Visibility="{Binding DataContext.NavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIf}}"
                                                   TextTrimming="CharacterEllipsis" FontSize="13.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="AddAccountButton" Style="{StaticResource SubtleButton}" Command="{Binding SwitchSchoolCommand}"
                            HorizontalContentAlignment="Left" Height="34" Padding="18,0" ToolTip="{x:Static loc:AppStrings.SidebarAddChildTooltip}"
                            AutomationProperties.Name="{x:Static loc:AppStrings.SidebarAddChild}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0"/>
                            <TextBlock Text="{x:Static loc:AppStrings.SidebarAddChild}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"
                                       Visibility="{Binding NavigationExpanded, Converter={StaticResource VisibleIf}}"/>
                        </StackPanel>
                    </Button>
                    <Border Height="1" Background="{DynamicResource Stroke}" Margin="8,10,8,0"/>
                </StackPanel>
                <Button x:Name="NavigationToggle" DockPanel.Dock="Bottom" Style="{StaticResource SubtleButton}" Command="{Binding ToggleNavigationCommand}"
                        HorizontalAlignment="Left" Height="34" Padding="18,0" Margin="0,0,0,8">
                    <TextBlock FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                <Setter Property="Text" Value="&#xE76B;"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                <Setter Property="ToolTip" Value="{x:Static loc:AppStrings.SidebarCollapseTooltip}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NavigationExpanded}" Value="False">
                                        <Setter Property="Text" Value="&#xE76C;"/>
                                        <Setter Property="ToolTip" Value="{x:Static loc:AppStrings.SidebarExpandTooltip}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button x:Name="SettingsButton" DockPanel.Dock="Bottom" Command="{Binding OpenSettingsCommand}" Height="36" Padding="0" Margin="0,0,0,4"
                        HorizontalContentAlignment="Stretch" ToolTip="{x:Static loc:AppStrings.SettingsTitle}" AutomationProperties.Name="{x:Static loc:AppStrings.SettingsTitle}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SettingsOpen}" Value="True"><Setter Property="Background" Value="{DynamicResource Selection}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Border Width="3" Height="20" HorizontalAlignment="Left" Background="{DynamicResource Accent}" CornerRadius="1.5"
                                Visibility="{Binding SettingsOpen, Converter={StaticResource VisibleIf}}"/>
                        <Grid Margin="12,0,10,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="16" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="{x:Static loc:AppStrings.SettingsTitle}" VerticalAlignment="Center" Margin="8,0" FontSize="13.5"
                                       Visibility="{Binding NavigationExpanded, Converter={StaticResource VisibleIf}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding SettingsOpen}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Button>
                <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Stroke}" Margin="8,0,8,8"/>
                <ListBox x:Name="FolderList" ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedFolder}"
                         PreviewMouseLeftButtonUp="FolderListClick"
                         AutomationProperties.Name="{x:Static loc:AppStrings.SidebarFoldersName}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectableRow}">
                            <Setter Property="Height" Value="36"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,0,10,0" ToolTip="{Binding Title}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Left">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource ThemeBrush}">
                                            <Binding Path="AccentKey"/>
                                            <Binding Path="DataContext.Theme.IsDark" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" FontSize="13.5"
                                           Visibility="{Binding DataContext.NavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIf}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="10" MinWidth="24" Padding="6,2" VerticalAlignment="Center"
                                        Visibility="{Binding DataContext.NavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIf}}">
                                    <TextBlock Text="{Binding Count}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8"
                    Visibility="{Binding ShowMessages, Converter={StaticResource VisibleIf}}">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Margin="12,12,12,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ListTitle" Text="{Binding FolderTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button x:Name="SyncButton" Style="{StaticResource PrimaryButton}" Grid.Column="1" VerticalAlignment="Center" Command="{Binding RefreshCommand}"
                                    ToolTip="{x:Static loc:AppStrings.MainRefreshTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SyncIcon" Text="&#xE895;" FontFamily="{StaticResource IconFont}"
                                               Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="SyncAnimation">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                     From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="SyncAnimation"/></DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AccentText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{x:Static loc:AppStrings.MainRefresh}"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsSyncing}" Value="True"><Setter Property="Text" Value="{x:Static loc:AppStrings.MainRefreshing}"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding FolderCaption}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,10" TextWrapping="Wrap"/>
                        <Grid>
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="30,7,28,7"
                                     AutomationProperties.Name="{x:Static loc:AppStrings.MainSearchMessages}" ToolTip="{x:Static loc:AppStrings.MainSearchTooltip}"/>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock Text="{x:Static loc:AppStrings.MainSearchMessages}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                       Margin="30,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Style="{StaticResource SubtleButton}" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="24" Height="24" MinHeight="0" Padding="0" Margin="0,0,4,0" ToolTip="{x:Static loc:AppStrings.MainClearSearch}" AutomationProperties.Name="{x:Static loc:AppStrings.MainClearSearch}"
                                    Visibility="{Binding SearchActive, Converter={StaticResource VisibleIf}}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10"/>
                            </Button>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static loc:AppStrings.MainSortLabel}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="SortBox" Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedValuePath="Value" SelectedValue="{Binding Sort}" FontSize="12"
                                      AutomationProperties.Name="{x:Static loc:AppStrings.MainSortName}"/>
                            <TextBlock Grid.Column="2" Text="{x:Static loc:AppStrings.MainGroupLabel}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <ComboBox x:Name="GroupBox" Grid.Column="3" ItemsSource="{Binding GroupOptions}" SelectedValuePath="Value" SelectedValue="{Binding Grouping}" FontSize="12"
                                      AutomationProperties.Name="{x:Static loc:AppStrings.MainGroupName}"/>
                        </Grid>
                    </StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding EmptyFolderText}" Visibility="{Binding EmptyFolder, Converter={StaticResource VisibleIf}}"
                                   Margin="12,24" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                        <ListBox x:Name="Messages" ItemsSource="{Binding MessagesView}" SelectedItem="{Binding SelectedMessage}" IsSynchronizedWithCurrentItem="False"
                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                                 ItemContainerStyle="{StaticResource SelectableRow}" AutomationProperties.Name="{x:Static loc:AppStrings.MainMessagesName}">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <StackPanel>
                                                            <ToggleButton x:Name="GroupHeader" IsChecked="True" Cursor="Hand" Focusable="True"
                                                                          AutomationProperties.Name="{Binding Name}" ToolTip="{x:Static loc:AppStrings.MainGroupHeaderTooltip}">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="12,8,12,4">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                                <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" VerticalAlignment="Center"
                                                                                           Foreground="{DynamicResource Accent}"/>
                                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Grid.Column="2" Text="{Binding ItemCount}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"/>
                                                                            </Grid>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="False"><Setter TargetName="Chevron" Property="Text" Value="&#xE76C;"/></Trigger>
                                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                            </ToggleButton>
                                                            <ItemsPresenter x:Name="GroupItems"/>
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger SourceName="GroupHeader" Property="IsChecked" Value="False">
                                                                <Setter TargetName="GroupItems" Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="{DynamicResource ListRowPadding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                     Visibility="{Binding Unread, Converter={StaticResource VisibleIf}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource ListSubjectSize}" ToolTip="{Binding Subject}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding Unread}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Text="{Binding ShortSent}" ToolTip="{Binding Sent}" FontSize="{DynamicResource ListDateSize}" Foreground="{DynamicResource TextSecondary}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1"                                             Text="{Binding Person}" FontSize="{DynamicResource ListSenderSize}" Foreground="{DynamicResource TextSecondary}"
                                                                                                   TextTrimming="CharacterEllipsis" Margin="{DynamicResource ListLineGap}"/>
                                                                                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{DynamicResource ListBadgeMargin}">
                                                <Border Background="{DynamicResource Avatar3Bg}" CornerRadius="4" Padding="5,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsExcuse, Converter={StaticResource VisibleIf}}" ToolTip="{x:Static loc:AppStrings.MessageExcuseLabel}">
                                                    <TextBlock Text="{x:Static loc:AppStrings.MessageExcuseBadge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Avatar3Fg}"/>
                                                </Border>
                                                <TextBlock Text="&#xE723;" Style="{StaticResource Icon}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"
                                                           Foreground="{DynamicResource TextSecondary}" Visibility="{Binding HasFiles, Converter={StaticResource VisibleIf}}"
                                                           AutomationProperties.Name="{x:Static loc:AppStrings.MessageHasAttachments}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" Background="Transparent" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="{x:Static loc:AppStrings.MainResizeMessageList}" AutomationProperties.Name="{x:Static loc:AppStrings.MainResizeMessageList}"
                          Visibility="{Binding ShowMessages, Converter={StaticResource VisibleIf}}"/>
            <Canvas x:Name="BuildRibbonArea" Grid.Column="4" Panel.ZIndex="10" Width="200" Height="124"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-12,-12,0" Visibility="Collapsed">
                <Canvas.Clip><RectangleGeometry Rect="0,0,200,124"/></Canvas.Clip>
                <Button x:Name="BuildRibbon" Canvas.Left="-90" Canvas.Top="23" Width="440" Height="44" Padding="12,2"
                        RenderTransformOrigin="0.5,0.5" Click="BuildRibbonClick"
                        AutomationProperties.Name="{x:Static loc:AppStrings.BuildRibbonDismiss}">
                    <Button.RenderTransform><RotateTransform Angle="35"/></Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="#F4A340"/>
                            <Setter Property="Foreground" Value="#281700"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2">
                                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFC06B"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#281700"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#E89530"/></Trigger>
                                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True"/>
                                        <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:AppStrings.BuildRibbonLabel}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="BuildRibbonTimestamp" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Canvas>
            <Border x:Name="ReadingPane" Grid.Column="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8"
                    Visibility="{Binding ShowMessages, Converter={StaticResource VisibleIf}}">
                <ScrollViewer x:Name="ReadingScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
                    <StackPanel>
                        <TextBlock x:Name="Subject" Text="{Binding Subject}" FontSize="{DynamicResource ReaderSubjectSize}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Border HorizontalAlignment="Left" Background="{DynamicResource Avatar3Bg}" CornerRadius="4" Padding="8,2" Margin="0,0,0,8"
                                Visibility="{Binding SelectedIsExcuse, Converter={StaticResource VisibleIf}}">
                            <TextBlock Text="{x:Static loc:AppStrings.MessageExcuseLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Avatar3Fg}"/>
                        </Border>
                        <Grid Margin="0,4,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top">
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource ThemeBrush}" ConverterParameter="Bg">
                                        <Binding Path="SenderColorKey"/>
                                        <Binding Path="Theme.IsDark"/>
                                    </MultiBinding>
                                </Border.Background>
                                <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource ThemeBrush}" ConverterParameter="Fg">
                                            <Binding Path="SenderColorKey"/>
                                            <Binding Path="Theme.IsDark"/>
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{Binding Sender}" FontSize="{DynamicResource ReaderSenderSize}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Metadata}" FontSize="{DynamicResource ReaderMetaSize}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="RelatedPanel" Margin="0,0,0,16" Visibility="{Binding HasRelated, Converter={StaticResource VisibleIf}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{x:Static loc:AppStrings.ReaderRelatedTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="12" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" Background="Transparent" Cursor="Help" ToolTipService.InitialShowDelay="0"
                                           AutomationProperties.Name="{x:Static loc:AppStrings.ReaderRelatedHelpName}"
                                           ToolTip="{x:Static loc:AppStrings.ReaderRelatedHelpTooltip}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Related}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SubtleButton}" Command="{Binding Owner.OpenRelatedCommand}" CommandParameter="{Binding}"
                                                Padding="8,4" Margin="0,0,6,4" ToolTip="{Binding Subject}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                                                AutomationProperties.Name="{Binding Label}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="11" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Direction}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="6,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,0,0,16"/>
                        <StackPanel x:Name="AttachmentPanel" Visibility="{Binding HasAttachments, Converter={StaticResource VisibleIf}}" Margin="0,0,0,20">
                            <ItemsControl ItemsSource="{Binding VisibleAttachments}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="AttachmentCard" Width="230" Height="46" CornerRadius="6"
                                                Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Margin="0,0,8,8">
                                            <Border.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="{x:Static loc:AppStrings.AttachmentOpen}" Command="{Binding Owner.OpenAttachmentCommand}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="{x:Static loc:AppStrings.AttachmentSaveAs}" Command="{Binding Owner.SaveAttachmentCommand}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="{x:Static loc:AppStrings.AttachmentOpenFolder}" Command="{Binding Owner.OpenFolderCommand}" CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Button Style="{StaticResource SubtleButton}" Command="{Binding Owner.OpenAttachmentCommand}" CommandParameter="{Binding}"
                                                        ToolTip="{Binding Availability}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Name}" Padding="8,4"
                                                        PreviewMouseLeftButtonDown="AttachmentMouseDown" PreviewMouseMove="AttachmentMouseMove"
                                                        HorizontalContentAlignment="Stretch">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                        <Grid Width="30" Height="30">
                                                            <Border CornerRadius="4">
                                                                <Border.Background>
                                                                    <MultiBinding Converter="{StaticResource ThemeBrush}" ConverterParameter="Bg">
                                                                        <Binding Path="BadgeKey"/>
                                                                        <Binding Path="DataContext.Theme.IsDark" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                    </MultiBinding>
                                                                </Border.Background>
                                                                <TextBlock Text="{Binding Type}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock.Foreground>
                                                                        <MultiBinding Converter="{StaticResource ThemeBrush}" ConverterParameter="Fg">
                                                                            <Binding Path="BadgeKey"/>
                                                                            <Binding Path="DataContext.Theme.IsDark" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Foreground>
                                                                </TextBlock>
                                                            </Border>
                                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource StatusGood}" Stroke="{DynamicResource Surface}" StrokeThickness="1"
                                                                     VerticalAlignment="Bottom" HorizontalAlignment="Right" Visibility="{Binding Cached, Converter={StaticResource VisibleIf}}"/>
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Size}" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <StackPanel x:Name="AttachmentActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Background="{DynamicResource AppBackground}" Margin="0,0,4,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Opacity" Value="0"/>
                                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource AnyTrue}">
                                                                            <Binding Path="IsMouseOver" ElementName="AttachmentCard"/>
                                                                            <Binding Path="IsKeyboardFocusWithin" ElementName="AttachmentCard"/>
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                                                    <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Button Style="{StaticResource IconButton}" Command="{Binding Owner.OpenAttachmentCommand}" CommandParameter="{Binding}" ToolTip="{x:Static loc:AppStrings.AttachmentOpen}" AutomationProperties.Name="{x:Static loc:AppStrings.AttachmentOpenName}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="14"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Command="{Binding Owner.SaveAttachmentCommand}" CommandParameter="{Binding}" ToolTip="{x:Static loc:AppStrings.AttachmentSaveAs}" AutomationProperties.Name="{x:Static loc:AppStrings.AttachmentSaveName}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="14"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding MoreAttachmentsLabel}" Command="{Binding ExpandAttachmentsCommand}"
                                        Visibility="{Binding HasMoreAttachments, Converter={StaticResource VisibleIf}}" Margin="0,0,8,0"/>
                                <Button Content="{x:Static loc:AppStrings.AttachmentSaveAll}" Command="{Binding SaveAllCommand}" Style="{StaticResource SubtleButton}"
                                        Foreground="{DynamicResource Accent}" Visibility="{Binding MultipleAttachments, Converter={StaticResource VisibleIf}}"
                                        ToolTip="{x:Static loc:AppStrings.AttachmentSaveAllTooltip}" ToolTipService.ShowOnDisabled="True"/>
                            </StackPanel>
                        </StackPanel>
                        <RichTextBox x:Name="ContentReader" local:MessageDocument.Parts="{Binding Body}" IsReadOnly="True" IsDocumentEnabled="True"
                                     PreviewMouseWheel="ReaderMouseWheel"
                                     BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                                     SelectionBrush="{DynamicResource Accent}" Padding="0" FontSize="14"
                                     VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="{x:Static loc:AppStrings.ReaderContentName}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <ScrollViewer x:Name="SettingsPage" Grid.Column="2" Grid.ColumnSpan="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding SettingsOpen, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="{x:Static loc:AppStrings.SettingsTitle}">
                <StackPanel Margin="20,4,20,24" MaxWidth="1000">
                    <Button Style="{StaticResource SubtleButton}" Command="{Binding CloseSettingsCommand}" HorizontalAlignment="Left" Padding="6,4"
                            ToolTip="{x:Static loc:AppStrings.SettingsBackTooltip}" AutomationProperties.Name="{x:Static loc:AppStrings.SettingsBack}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"/>
                            <TextBlock Text="{x:Static loc:AppStrings.SettingsBack}" FontSize="12.5" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{x:Static loc:AppStrings.SettingsTitle}" FontSize="28" FontWeight="SemiBold" Margin="6,6,0,18"/>

                    <Expander x:Name="AppearanceSection" Style="{StaticResource SettingsExpander}" AutomationProperties.Name="{x:Static loc:AppStrings.SettingsAppearance}">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" FontSize="20" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Static loc:AppStrings.SettingsAppearance}" FontSize="14"/>
                                    <TextBlock Text="{x:Static loc:AppStrings.SettingsAppearanceDescription}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Expander.Header>
                        <StackPanel>
                            <Grid Margin="72,14,20,14">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:AppStrings.SettingsTheme}" FontSize="13.5"/>
                                    <TextBlock Text="{x:Static loc:AppStrings.SettingsThemeDescription}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="LightThemeButton" Style="{StaticResource SegmentButton}" Command="{Binding SetThemeCommand}" CommandParameter="Light"
                                            Tag="{Binding Theme.IsLight}" AutomationProperties.Name="{x:Static loc:AppStrings.SettingsThemeLightName}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{x:Static loc:AppStrings.SettingsThemeLight}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DarkThemeButton" Style="{StaticResource SegmentButton}" Command="{Binding SetThemeCommand}" CommandParameter="Dark"
                                            Tag="{Binding Theme.IsDark}" AutomationProperties.Name="{x:Static loc:AppStrings.SettingsThemeDarkName}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{x:Static loc:AppStrings.SettingsThemeDark}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Stroke}" Margin="20,0"/>
                            <Grid Margin="72,14,20,14">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:AppStrings.SettingsReadingSize}" FontSize="13.5"/>
                                    <TextBlock Text="{x:Static loc:AppStrings.SettingsReadingSizeDescription}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Static loc:AppStrings.SettingsReadingSizeName}">
                                    <Button x:Name="SmallTextButton" Style="{StaticResource SegmentButton}" Content="{x:Static loc:AppStrings.SettingsReadingSizeSmall}"
                                            Command="{Binding SetReadingSizeCommand}" CommandParameter="Small" Tag="{Binding Theme.IsSmallText}"/>
                                    <Button x:Name="MediumTextButton" Style="{StaticResource SegmentButton}" Content="{x:Static loc:AppStrings.SettingsReadingSizeMedium}"
                                            Command="{Binding SetReadingSizeCommand}" CommandParameter="Medium" Tag="{Binding Theme.IsMediumText}"/>
                                    <Button x:Name="LargeTextButton" Style="{StaticResource SegmentButton}" Content="{x:Static loc:AppStrings.SettingsReadingSizeLarge}"
                                            Command="{Binding SetReadingSizeCommand}" CommandParameter="Large" Tag="{Binding Theme.IsLargeText}"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Stroke}" Margin="20,0"/>
                            <Grid Margin="72,14,20,14">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:AppStrings.SettingsListDensity}" FontSize="13.5"/>
                                    <TextBlock Text="{x:Static loc:AppStrings.SettingsListDensityDescription}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Static loc:AppStrings.SettingsListDensityName}">
                                    <Button x:Name="CompactListButton" Style="{StaticResource SegmentButton}" Content="{x:Static loc:AppStrings.SettingsListDensityCompact}"
                                            Command="{Binding SetListDensityCommand}" CommandParameter="Compact" Tag="{Binding Theme.IsCompactList}"/>
                                    <Button x:Name="RelaxedListButton" Style="{StaticResource SegmentButton}" Content="{x:Static loc:AppStrings.SettingsListDensityRelaxed}"
                                            Command="{Binding SetListDensityCommand}" CommandParameter="Relaxed" Tag="{Binding Theme.IsRelaxedList}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="AccountsSection" Style="{StaticResource SettingsExpander}" AutomationProperties.Name="{x:Static loc:AppStrings.SettingsAccounts}">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="20" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Static loc:AppStrings.SettingsAccounts}" FontSize="14"/>
                                    <TextBlock Text="{x:Static loc:AppStrings.SettingsAccountsDescription}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:AppStrings.SettingsNoAccounts}" Margin="72,14,20,14" FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Accounts.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl x:Name="SettingsAccounts" ItemsSource="{Binding Accounts}" AutomationProperties.Name="{x:Static loc:AppStrings.SettingsSavedAccountsName}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Margin="20,0" Padding="0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <MultiBinding Converter="{StaticResource ThemeBrush}" ConverterParameter="Bg">
                                                            <Binding Path="ColorKey"/>
                                                            <Binding Path="DataContext.Theme.IsDark" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        </MultiBinding>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Foreground>
                                                            <MultiBinding Converter="{StaticResource ThemeBrush}" ConverterParameter="Fg">
                                                                <Binding Path="ColorKey"/>
                                                                <Binding Path="DataContext.Theme.IsDark" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Label}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SettingsDetail}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SettingsDetail}"/>
                                                </StackPanel>
                                                <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Button Content="{x:Static loc:AppStrings.SettingsRename}" Margin="6,2,0,2" MinWidth="88"
                                                            Command="{Binding RenameAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                            ToolTip="{x:Static loc:AppStrings.SettingsRenameTooltip}" AutomationProperties.Name="{Binding Label, StringFormat={x:Static loc:AppStrings.SettingsRenameName}}"/>
                                                    <Button Content="{x:Static loc:AppStrings.SettingsChangePassword}" Margin="6,2,0,2" Visibility="{Binding PasswordSaved, Converter={StaticResource VisibleIf}}"
                                                            Command="{Binding SetPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                            ToolTip="{x:Static loc:AppStrings.SettingsChangePasswordTooltip}" AutomationProperties.Name="{Binding Label, StringFormat={x:Static loc:AppStrings.SettingsChangePasswordFor}}"/>
                                                    <Button Content="{x:Static loc:AppStrings.SettingsClearPassword}" Margin="6,2,0,2" Visibility="{Binding PasswordSaved, Converter={StaticResource VisibleIf}}"
                                                            Command="{Binding ClearPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                            ToolTip="{x:Static loc:AppStrings.SettingsClearPasswordTooltip}" AutomationProperties.Name="{Binding Label, StringFormat={x:Static loc:AppStrings.SettingsClearPasswordFor}}"/>
                                                    <Button Content="{x:Static loc:AppStrings.SettingsSavePassword}" Margin="6,2,0,2" Visibility="{Binding PasswordMissing, Converter={StaticResource VisibleIf}}"
                                                            Command="{Binding SetPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                            ToolTip="{x:Static loc:AppStrings.SettingsSavePasswordTooltip}" AutomationProperties.Name="{Binding Label, StringFormat={x:Static loc:AppStrings.SettingsSavePasswordFor}}"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                <Setter TargetName="Row" Property="BorderThickness" Value="0"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="AboutSection" Style="{StaticResource SettingsExpander}" AutomationProperties.Name="{x:Static loc:AppStrings.SettingsAbout}">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="20" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Static loc:AppStrings.SettingsAbout}" FontSize="14"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"
                                               Text="{Binding VersionText, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={x:Static loc:AppStrings.SettingsAboutDescription}}"/>
                                </StackPanel>
                            </Grid>
                        </Expander.Header>
                        <StackPanel>
                            <Grid Margin="72,14,20,14">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static loc:AppStrings.SettingsInstalledVersion}" FontSize="13.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding VersionText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="13.5"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Stroke}" Margin="20,0"/>
                            <Grid Margin="72,14,20,14">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{x:Static loc:AppStrings.SettingsUpdates}" FontSize="13.5"/>
                                    <TextBlock x:Name="SettingsUpdateText" Text="{Binding Updates.Text, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{x:Static loc:AppStrings.SettingsCheckNow}" MinWidth="104" VerticalAlignment="Center"
                                        Command="{Binding Updates.CheckNowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="{x:Static loc:AppStrings.SettingsCheckNowTooltip}" ToolTipService.ShowOnDisabled="True"/>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="3" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse Width="6" Height="6" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding GoodStatus}" Value="True"><Setter Property="Fill" Value="{DynamicResource StatusGood}"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock x:Name="Status" Grid.Column="1" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static loc:AppStrings.StatusLoadingArchive}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                               Margin="12,0,0,0" Visibility="{Binding Loading, Converter={StaticResource VisibleIf}}"/>
                    <TextBlock x:Name="UpdateText" Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="360"
                               ToolTip="{Binding CheckTooltip}" MouseLeftButtonUp="UpdateTextClick"
                               AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{x:Static loc:AppStrings.UpdateStatusName}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanCheckNow}" Value="True"><Setter Property="Cursor" Value="Hand"/></DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CanCheckNow}" Value="True"/>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel x:Name="UpdateActions" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsReady, Converter={StaticResource VisibleIf}}">
                        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static loc:AppStrings.UpdateRestart}" Command="{Binding InstallCommand}"
                                FontSize="11" MinHeight="0" Height="22" Padding="10,0"/>
                        <Button x:Name="UpdateMenuButton" Style="{StaticResource PrimaryButton}" Margin="1,0,0,0" FontSize="11" MinHeight="0" Height="22" Width="24" Padding="0"
                                Click="UpdateMenuClick" ToolTip="{x:Static loc:AppStrings.UpdateMoreOptions}" AutomationProperties.Name="{x:Static loc:AppStrings.UpdateMoreOptions}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" Foreground="{DynamicResource AccentText}"/>
                        </Button>
                        <Popup PlacementTarget="{Binding ElementName=UpdateMenuButton}" Placement="Top" HorizontalOffset="-150"
                               IsOpen="{Binding MenuOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="6" Width="200">
                                <StackPanel>
                                    <Button Style="{StaticResource SubtleButton}" Content="{x:Static loc:AppStrings.UpdateIgnore}" HorizontalContentAlignment="Left"
                                            Command="{Binding IgnoreCommand}" FontSize="12"/>
                                    <Button Style="{StaticResource SubtleButton}" Content="{x:Static loc:AppStrings.UpdateInstallOnExit}" HorizontalContentAlignment="Left"
                                            Command="{Binding InstallOnExitCommand}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
