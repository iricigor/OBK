<Window x:Class="OBK.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:OBK.App"
        Style="{StaticResource {x:Type Window}}" Title="{Binding WindowTitle}"
        Width="1380" Height="840" MinWidth="880" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize"
        Loaded="WindowLoaded" Closing="WindowClosing" SizeChanged="WindowSizeChanged" SourceInitialized="WindowSourceInitialized">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="WindowRoot" Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" Margin="20,0,150,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE715;" Foreground="{DynamicResource Accent}" FontSize="14" Margin="0,0,8,0"/>
                <TextBlock Text="OBK - Offline Komens" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Text="{Binding AccountLabel}" ToolTip="{Binding AccountLabel}" MaxWidth="420"
                           TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="16,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Width="46" Height="40" MinHeight="0" Style="{StaticResource SubtleButton}"
                        Command="{Binding MinimizeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="Minimize" AutomationProperties.Name="Minimize">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE921;" FontSize="10"/>
                </Button>
                <Button x:Name="MaximizeButton" Width="46" Height="40" MinHeight="0" Style="{StaticResource SubtleButton}"
                        Command="{Binding MaximizeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="Maximize / Restore" AutomationProperties.Name="Maximize or restore">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE922;" FontSize="10"/>
                </Button>
                <Button Width="46" Height="40" MinHeight="0" Style="{StaticResource CloseButton}" Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="Close" AutomationProperties.Name="Close">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8BB;" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="20,8,20,16">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="OBK" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="{Binding AccountLabel}" ToolTip="{Binding AccountLabel}" MaxWidth="360"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,20,0"/>
                <Border x:Name="YearBadge" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}"
                        BorderThickness="1" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="YearLabel" Text="{Binding YearLabel}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}" ToolTip="{Binding Theme.ToggleTooltip}"
                        AutomationProperties.Name="{Binding Theme.ToggleTooltip}" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Theme.ToggleIcon}"/>
                </Button>
                <Button x:Name="SwitchSchoolButton" Style="{StaticResource SubtleButton}" Command="{Binding SwitchSchoolCommand}"
                        Content="Switch school" Margin="0,0,8,0"/>
                <Button x:Name="SyncButton" Style="{StaticResource PrimaryButton}" Command="{Binding SignInCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SyncIcon" Text="&#xE895;" FontFamily="{StaticResource IconFont}"
                                   Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="SyncAnimation">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="SyncAnimation"/></DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource AccentText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Sign in / Sync"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsSyncing}" Value="True"><Setter Property="Text" Value="Syncing..."/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="210" MinWidth="140"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition x:Name="MessageColumn" Width="360" MinWidth="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            <DockPanel Margin="4,8,4,0">
                <TextBlock Text="{Binding School}" FontWeight="SemiBold" TextWrapping="Wrap" DockPanel.Dock="Top" Margin="12,0,12,18"/>
                <TextBlock DockPanel.Dock="Bottom" Text="OFFLINE KOMENS" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="12,16"/>
                <ListBox x:Name="FolderList" ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedFolder}"
                         AutomationProperties.Name="Folders">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectableRow}">
                            <Setter Property="Height" Value="36"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,0,10,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="10" MinWidth="24" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Count}" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Margin="12,12,12,14">
                        <TextBlock x:Name="ListTitle" Text="{Binding FolderTitle}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FolderCaption}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding EmptyFolderText}" Visibility="{Binding EmptyFolder, Converter={StaticResource VisibleIf}}"
                                   Margin="12,24" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                        <ListBox x:Name="Messages" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}"
                                 ItemContainerStyle="{StaticResource SelectableRow}" AutomationProperties.Name="Messages">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,7,4,0"
                                                     Visibility="{Binding Unread, Converter={StaticResource VisibleIf}}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Subject}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" FontSize="14" FontWeight="SemiBold" ToolTip="{Binding Subject}"/>
                                                <TextBlock Text="{Binding Person}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding Sent}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE723;" Style="{StaticResource Icon}" FontSize="13" VerticalAlignment="Top" Margin="6,3,0,0"
                                                       Foreground="{DynamicResource TextSecondary}" Visibility="{Binding HasFiles, Converter={StaticResource VisibleIf}}"
                                                       AutomationProperties.Name="Has attachments"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" Background="Transparent" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="Resize message list" AutomationProperties.Name="Resize message list"/>
            <Border Grid.Column="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer x:Name="ReadingScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
                    <StackPanel>
                        <TextBlock x:Name="Subject" Text="{Binding Subject}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Selection}" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Initials}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Metadata}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,0,0,16"/>
                        <StackPanel x:Name="AttachmentPanel" Visibility="{Binding HasAttachments, Converter={StaticResource VisibleIf}}" Margin="0,0,0,20">
                            <ItemsControl ItemsSource="{Binding VisibleAttachments}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="AttachmentCard" Width="230" Height="46" CornerRadius="6"
                                                Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Margin="0,0,8,8">
                                            <Border.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Open" Command="{Binding Owner.OpenAttachmentCommand}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Save as..." Command="{Binding Owner.SaveAttachmentCommand}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Open folder" Command="{Binding Owner.OpenFolderCommand}" CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Button Style="{StaticResource SubtleButton}" Command="{Binding Owner.OpenAttachmentCommand}" CommandParameter="{Binding}"
                                                        ToolTip="{Binding Availability}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Name}" Padding="8,4"
                                                        PreviewMouseLeftButtonDown="AttachmentMouseDown" PreviewMouseMove="AttachmentMouseMove"
                                                        HorizontalContentAlignment="Stretch">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                        <Grid Width="30" Height="30">
                                                            <Border Background="{DynamicResource Selection}" CornerRadius="4">
                                                                <TextBlock Text="{Binding Type}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource StatusGood}" Stroke="{DynamicResource Surface}" StrokeThickness="1"
                                                                     VerticalAlignment="Bottom" HorizontalAlignment="Right" Visibility="{Binding Cached, Converter={StaticResource VisibleIf}}"/>
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Size}" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <StackPanel x:Name="AttachmentActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Background="{DynamicResource AppBackground}" Margin="0,0,4,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Opacity" Value="0"/>
                                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource AnyTrue}">
                                                                            <Binding Path="IsMouseOver" ElementName="AttachmentCard"/>
                                                                            <Binding Path="IsKeyboardFocusWithin" ElementName="AttachmentCard"/>
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                                                    <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Button Style="{StaticResource IconButton}" Command="{Binding Owner.OpenAttachmentCommand}" CommandParameter="{Binding}" ToolTip="Open" AutomationProperties.Name="Open attachment">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="14"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Command="{Binding Owner.SaveAttachmentCommand}" CommandParameter="{Binding}" ToolTip="Save as..." AutomationProperties.Name="Save attachment">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="14"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding MoreAttachmentsLabel}" Command="{Binding ExpandAttachmentsCommand}"
                                        Visibility="{Binding HasMoreAttachments, Converter={StaticResource VisibleIf}}" Margin="0,0,8,0"/>
                                <Button Content="Save all" Command="{Binding SaveAllCommand}" Style="{StaticResource SubtleButton}"
                                        Foreground="{DynamicResource Accent}" Visibility="{Binding MultipleAttachments, Converter={StaticResource VisibleIf}}"
                                        ToolTip="Save copies of all attachments. Sync first if any attachment is not downloaded." ToolTipService.ShowOnDisabled="True"/>
                            </StackPanel>
                        </StackPanel>
                        <RichTextBox x:Name="ContentReader" local:MessageDocument.Parts="{Binding Body}" IsReadOnly="True" IsDocumentEnabled="False"
                                     PreviewMouseWheel="ReaderMouseWheel"
                                     BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                                     SelectionBrush="{DynamicResource Accent}" Padding="0" FontSize="14"
                                     VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Message content"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="3" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse Width="6" Height="6" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding GoodStatus}" Value="True"><Setter Property="Fill" Value="{DynamicResource StatusGood}"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock x:Name="Status" Grid.Column="1" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Loading archive..." FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                               Margin="12,0,0,0" Visibility="{Binding Loading, Converter={StaticResource VisibleIf}}"/>
                    <TextBlock x:Name="UpdateText" Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="360" ToolTip="{Binding Text}"
                               AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Update status"/>
                    <StackPanel x:Name="UpdateActions" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsReady, Converter={StaticResource VisibleIf}}">
                        <Button Style="{StaticResource PrimaryButton}" Content="Update and restart" Command="{Binding InstallCommand}"
                                FontSize="11" MinHeight="0" Height="22" Padding="10,0"/>
                        <Button x:Name="UpdateMenuButton" Style="{StaticResource PrimaryButton}" Margin="1,0,0,0" FontSize="11" MinHeight="0" Height="22" Width="24" Padding="0"
                                Click="UpdateMenuClick" ToolTip="More update options" AutomationProperties.Name="More update options">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" Foreground="{DynamicResource AccentText}"/>
                        </Button>
                        <Popup PlacementTarget="{Binding ElementName=UpdateMenuButton}" Placement="Top" HorizontalOffset="-150"
                               IsOpen="{Binding MenuOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="6" Width="200">
                                <StackPanel>
                                    <Button Style="{StaticResource SubtleButton}" Content="Ignore during this session" HorizontalContentAlignment="Left"
                                            Command="{Binding IgnoreCommand}" FontSize="12"/>
                                    <Button Style="{StaticResource SubtleButton}" Content="Install when I exit" HorizontalContentAlignment="Left"
                                            Command="{Binding InstallOnExitCommand}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
