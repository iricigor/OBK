<Window x:Class="OBK.App.TransferWindow" Icon="pack://application:,,,/Assets/OBK.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:OBK.App.Localization"
        Style="{StaticResource {x:Type Window}}" Title="{x:Static loc:AppStrings.TransferTitle}"
        Width="640" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="40">
                <TextBlock Text="OBK" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="24,0"/>
                <Button HorizontalAlignment="Right" Width="40" Height="40" Style="{StaticResource SubtleButton}" Click="CloseClick"
                        ToolTip="{x:Static loc:AppStrings.CommonClose}" AutomationProperties.Name="{x:Static loc:AppStrings.CommonClose}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10"/>
                </Button>
            </Grid>
            <StackPanel Margin="24,4,24,20">
                <TextBlock Text="{x:Static loc:AppStrings.TransferTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="AccountText" FontSize="13.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                <TextBlock Text="{x:Static loc:AppStrings.TransferDescription}" Foreground="{DynamicResource TextSecondary}" FontSize="12.5"
                           TextWrapping="Wrap" Margin="0,0,0,16"/>
                <Grid MinHeight="252">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel x:Name="CodePanel" Grid.ColumnSpan="2" Orientation="Horizontal" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:AppStrings.TransferStepScan}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <!-- QR codes need dark modules on a light background in every theme. -->
                            <Border Background="White" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="4" Padding="12">
                                <Image x:Name="QrImage" Width="200" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       RenderOptions.EdgeMode="Aliased" AutomationProperties.Name="{x:Static loc:AppStrings.TransferQrName}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="28,0,0,0" Width="300">
                            <TextBlock Text="{x:Static loc:AppStrings.TransferStepWords}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource HeaderSurface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                                    CornerRadius="4" Padding="16,14">
                                <TextBlock x:Name="WordsText" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="34"
                                           AutomationProperties.Name="{x:Static loc:AppStrings.TransferWordsName}"/>
                            </Border>
                            <TextBlock x:Name="CountdownText" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" Margin="0,10,0,0"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="PlaceholderText" Grid.ColumnSpan="2" Foreground="{DynamicResource TextSecondary}" FontSize="13.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               AutomationProperties.LiveSetting="Assertive"/>
                </Grid>
                <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,16,0,0">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="16" Foreground="{DynamicResource FolderNotice}"
                                   VerticalAlignment="Top" Margin="0,1,10,0"/>
                        <TextBlock Text="{x:Static loc:AppStrings.TransferWarning}" FontSize="12.5" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <TextBlock Text="{x:Static loc:AppStrings.TransferScope}" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="ShowNewButton" Content="{x:Static loc:AppStrings.TransferShowNew}" MinWidth="120" Click="ShowNewClick"/>
                    <Button Content="{x:Static loc:AppStrings.CommonClose}" Style="{StaticResource PrimaryButton}" MinWidth="96"
                            Margin="8,0,0,0" IsCancel="True" Click="CloseClick"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
