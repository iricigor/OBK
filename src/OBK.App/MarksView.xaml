<UserControl x:Class="OBK.App.MarksView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:OBK.Core.Localization;assembly=OBK.Core"
    xmlns:loc="clr-namespace:OBK.App.Localization">
    <UserControl.Resources>
        <Style x:Key="MarksRowButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MarksTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource Selection}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ListWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*" MinWidth="260"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Margin="12,12,12,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static shared:SharedStrings.MarksTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="{x:Static loc:AppStrings.MainRefresh}" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}"/>
                    </Grid>
                    <TextBlock Text="{Binding ScopeText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,12" TextWrapping="Wrap"/>
                    <Grid>
                        <TextBox x:Name="MarksSearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="10,8"
                                 ToolTip="{x:Static shared:SharedStrings.MarksSearch}" AutomationProperties.Name="{x:Static shared:SharedStrings.MarksSearch}"/>
                        <TextBlock Text="{x:Static shared:SharedStrings.MarksSearch}" Margin="10,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=MarksSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton Content="{x:Static shared:SharedStrings.MarksSubjects}" IsChecked="{Binding IsSubjects}" Margin="0,0,18,0" Style="{StaticResource MarksTab}"/>
                        <RadioButton Content="{x:Static shared:SharedStrings.MarksRecent}" IsChecked="{Binding IsRecent}" Style="{StaticResource MarksTab}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Notice}" Visibility="{Binding HasNotice, Converter={StaticResource VisibleIf}}"
                               Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <Grid>
                    <TextBlock Text="{Binding EmptyText}" Visibility="{Binding Empty, Converter={StaticResource VisibleIf}}"
                               Margin="12,20" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                    <ListBox x:Name="MarksList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" IsSynchronizedWithCurrentItem="False"
                             AutomationProperties.Name="{x:Static shared:SharedStrings.MarksTitle}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectableRow}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAlternate}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ListAlternateSurface}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        Style="{StaticResource MarksRowButton}" AutomationProperties.Name="{Binding AccessibleName}">
                                    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="{DynamicResource ListRowPadding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                 Visibility="{Binding IsNew, Converter={StaticResource VisibleIf}}"/>
                                        <Border Grid.Column="1" Grid.RowSpan="2" Width="24" Height="24" CornerRadius="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                                Visibility="{Binding ShowOwner, Converter={StaticResource VisibleIf}}">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource ThemeBrush}" ConverterParameter="Bg">
                                                    <Binding Path="OwnerColorKey"/>
                                                    <Binding Path="DataContext.Theme.IsDark" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Border.Background>
                                            <TextBlock Text="{Binding OwnerInitials}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Foreground>
                                                    <MultiBinding Converter="{StaticResource ThemeBrush}" ConverterParameter="Fg">
                                                        <Binding Path="OwnerColorKey"/>
                                                        <Binding Path="DataContext.Theme.IsDark" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="{DynamicResource ListSubjectSize}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}">
                                            <TextBlock.Style><Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsNew}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Text="{Binding Value}" FontSize="{DynamicResource ListSubjectSize}" FontWeight="SemiBold" Margin="8,0,0,0"
                                                   HorizontalAlignment="Right" MaxWidth="90" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RowSubtitle}" FontSize="{DynamicResource ListSenderSize}"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="{DynamicResource ListLineGap}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RowSubtitle}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding RowDetail}" FontSize="{DynamicResource ListDateSize}"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="{DynamicResource ListBadgeMargin}" HorizontalAlignment="Right"
                                                   MaxWidth="140" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                    </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
        <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <TextBlock Text="{x:Static shared:SharedStrings.MarksNoSelection}" Margin="24" Foreground="{DynamicResource TextSecondary}"/>
                <ScrollViewer Visibility="{Binding HasSubject, Converter={StaticResource VisibleIf}}" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface}">
                    <StackPanel>
                        <Border Background="{DynamicResource MessageHeaderSurface}" Padding="24">
                            <StackPanel DataContext="{Binding SelectedSubject}">
                                <TextBlock Text="{Binding Subject.Subject.Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding OwnerLabel}" FontWeight="SemiBold" Margin="0,16,0,4"/>
                                <TextBlock Text="{Binding Period}" FontSize="12" Foreground="{DynamicResource MessageHeaderSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource RelatedSurface}" Padding="24,16">
                            <StackPanel DataContext="{Binding SelectedSubject}">
                                <TextBlock Text="{Binding AverageLabel}" FontSize="12" Foreground="{DynamicResource MessageHeaderSecondary}"/>
                                <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource MessageHeaderSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="24">
                            <TextBlock Text="{x:Static shared:SharedStrings.MarksAssessments}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="{x:Static shared:SharedStrings.MarksEmpty}" Visibility="{Binding SelectedSubject.NoAssessments, Converter={StaticResource VisibleIf}}"
                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding SelectedSubject.Assessments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Stretch" Padding="0,12"
                                                Command="{Binding DataContext.OpenAssessmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleName}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold" MinWidth="40" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{x:Static shared:SharedStrings.MarksNew}" FontSize="11" Foreground="{DynamicResource Accent}" Visibility="{Binding IsNew, Converter={StaticResource VisibleIf}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="{DynamicResource ListAlternateSurface}" Padding="16" Margin="0,16,0,0" Visibility="{Binding HasAssessment, Converter={StaticResource VisibleIf}}">
                                <StackPanel DataContext="{Binding SelectedAssessment}">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding AssessmentDetail}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding SelectedSubject.Provisional}" Margin="0,16,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedSubject.Subject.TemporaryMarkNote}" TextWrapping="Wrap" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedSubject.Subject.SubjectNote}" TextWrapping="Wrap" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedSubject.SnapshotText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"/>
                            <TextBlock Text="{x:Static shared:SharedStrings.MarksLimit}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
