<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>OBK</AssemblyName>
    <Product>OBK</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\OBK.ico</ApplicationIcon>
    <NeutralLanguage>en</NeutralLanguage>
    <LocalBuild Condition="'$(LocalBuild)' == ''">true</LocalBuild>
    <BuildTimestamp Condition="'$(BuildTimestamp)' == ''">$([System.DateTime]::UtcNow.ToString('O'))</BuildTimestamp>
  </PropertyGroup>
  <Target Name="ValidateLocalBuild" BeforeTargets="GenerateAssemblyInfo">
    <Error Condition="'$(LocalBuild)' != 'true' and '$(LocalBuild)' != 'false'"
           Text="LocalBuild must be true or false." />
  </Target>
  <ItemGroup>
    <AssemblyMetadata Include="LocalBuild" Value="$(LocalBuild)" />
    <AssemblyMetadata Include="BuildTimestamp" Value="$(BuildTimestamp)" />
  </ItemGroup>
  <ItemGroup>
    <LocalizedStrings Include="Localization\AppStrings.resx" />
  </ItemGroup>
  <Import Project="..\Localization.targets" />
  <ItemGroup>
    <Resource Include="Assets\OBK.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OBK.Core\OBK.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\schools.json.gz" LogicalName="OBK.App.Data.schools.json.gz" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.9.0" />
  </ItemGroup>
</Project>
